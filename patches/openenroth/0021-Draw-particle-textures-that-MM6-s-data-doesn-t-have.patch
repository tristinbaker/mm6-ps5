Subject: [PATCH] Draw particle textures that MM6's data doesn't have

Spell trails in MM6, like a goblin's fire bolt, drew a cloud of error images. The particle textures effpar01-03
came with MM7's spell effects and aren't in MM6's bitmaps.lod. When a texture is missing, SpellFxRenderer now
draws a 64x64 greyscale look-alike of MM7's (two soft blobs, a sparkle, one soft blob), which the particle
renderer tints and blends like the originals. MM7 still loads its own. Mm6.SpellParticleTextures checks the
textures the renderer ends up with.
---
 src/Engine/Resources/LodTextureCache.h |  4 ++
 src/Engine/SpellFxRenderer.cpp         | 53 ++++++++++++++++++++++++--
 test/Bin/GameTest/GameTests_Mm6.cpp    | 17 +++++++++
 3 files changed, 71 insertions(+), 3 deletions(-)

diff --git a/src/Engine/Resources/LodTextureCache.h b/src/Engine/Resources/LodTextureCache.h
index ef31e5d..db5c40c 100644
--- a/src/Engine/Resources/LodTextureCache.h
+++ b/src/Engine/Resources/LodTextureCache.h
@@ -24,6 +24,10 @@ class LodTextureCache {
 
     LodImage *loadTexture(std::string_view pContainer, bool useDummyOnError = true);
 
+    [[nodiscard]] bool exists(std::string_view pContainer) const {
+        return _reader.exists(pContainer);
+    }
+
     Blob LoadCompressedTexture(std::string_view pContainer); // TODO(captainurist): doesn't belong here.
     Blob read(std::string_view pContainer); // TODO(captainurist): doesn't belong here.
 
diff --git a/src/Engine/SpellFxRenderer.cpp b/src/Engine/SpellFxRenderer.cpp
index d4faf33..b4cdd3e 100644
--- a/src/Engine/SpellFxRenderer.cpp
+++ b/src/Engine/SpellFxRenderer.cpp
@@ -1,12 +1,15 @@
 #include "Engine/SpellFxRenderer.h"
 
 #include <algorithm>
+#include <cmath>
 
 #include "Engine/Engine.h"
 #include "Engine/OurMath.h"
 #include "Engine/Time/Timer.h"
 #include "Engine/Party.h"
 #include "Engine/AssetsManager.h"
+#include "Engine/Graphics/Image.h"
+#include "Engine/Resources/LodTextureCache.h"
 
 #include "Engine/Graphics/Camera.h"
 #include "Engine/Graphics/Indoor.h"
@@ -1188,11 +1191,55 @@ void SpellFxRenderer::DrawPlayerBuffAnims() {
     }
 }
 
+enum class ParticleShape {
+    TWIN_GLOW, // effpar01: two soft blobs on a diagonal.
+    SPARKLE, // effpar02: a small four-pointed star.
+    GLOW, // effpar03: one soft blob.
+};
+
+/**
+ * @return                              The particle texture `name` from bitmaps.lod, or a look-alike drawn here if
+ *                                      there's none: MM6's data has no particle textures (MM7 added the spell
+ *                                      trails), and a missing one draws as the error image. Like MM7's, they're
+ *                                      64x64 greyscale on black, tinted per particle and blended additively.
+ */
+static GraphicsImage *particleTexture(std::string_view name, ParticleShape shape) {
+    if (pBitmaps_LOD->exists(name))
+        return assets->getBitmap(name);
+
+    auto blob = [](float x, float y, float cx, float cy, float sigma) {
+        return std::exp(-((x - cx) * (x - cx) + (y - cy) * (y - cy)) / (2 * sigma * sigma));
+    };
+    RgbaImage image = RgbaImage::uninitialized(64, 64);
+    for (int y = 0; y < 64; y++) {
+        for (int x = 0; x < 64; x++) {
+            float value = 0;
+            switch (shape) {
+            case ParticleShape::TWIN_GLOW:
+                value = std::max(blob(x, y, 40, 19, 8), blob(x, y, 30, 36, 8));
+                break;
+            case ParticleShape::SPARKLE: {
+                float dx = x - 32.0f, dy = y - 31.0f;
+                float arms = std::exp(-dx * dx / 2 - dy * dy / 50) + std::exp(-dy * dy / 2 - dx * dx / 50);
+                value = std::min(1.0f, blob(x, y, 32, 31, 2.5f) + 0.8f * arms);
+                break;
+            }
+            case ParticleShape::GLOW:
+                value = blob(x, y, 32, 32, 11);
+                break;
+            }
+            uint8_t grey = static_cast<uint8_t>(std::clamp(value, 0.0f, 1.0f) * 255);
+            image[y][x] = Color(grey, grey, grey);
+        }
+    }
+    return GraphicsImage::Create(std::move(image));
+}
+
 //----- (004A90A0) --------------------------------------------------------
 void SpellFxRenderer::LoadAnimations() {
-    effpar01 = assets->getBitmap("effpar01");  // pBitmaps_LOD->LoadTexture("effpar01");
-    effpar02 = assets->getBitmap("effpar02");  // pBitmaps_LOD->LoadTexture("effpar02");
-    effpar03 = assets->getBitmap("effpar03");  // pBitmaps_LOD->LoadTexture("effpar03");
+    effpar01 = particleTexture("effpar01", ParticleShape::TWIN_GLOW);
+    effpar02 = particleTexture("effpar02", ParticleShape::SPARKLE);
+    effpar03 = particleTexture("effpar03", ParticleShape::GLOW);
 
     // spell not implemented in the game
     // uSpriteID_sp57c = pSprites_LOD->LoadSprite("sp57c", 6);
diff --git a/test/Bin/GameTest/GameTests_Mm6.cpp b/test/Bin/GameTest/GameTests_Mm6.cpp
index 96e49a6..a2f4377 100644
--- a/test/Bin/GameTest/GameTests_Mm6.cpp
+++ b/test/Bin/GameTest/GameTests_Mm6.cpp
@@ -59,6 +59,8 @@
 #include "Engine/Spells/SpellEnums.h"
 #include "Engine/Spells/SpellEnumFunctions.h"
 #include "Engine/Spells/Spells.h"
+#include "Engine/EngineIocContainer.h"
+#include "Engine/SpellFxRenderer.h"
 #include "Engine/Tables/AutonoteTable.h"
 #include "Engine/Tables/AwardTable.h"
 #include "Engine/Tables/HouseTable.h"
@@ -10406,3 +10408,18 @@ GAME_TEST(Mm6, BowArrowsHit) {
     EXPECT_GT(arrowsSeen, 0);
     EXPECT_EQ(pActors[peasantId].aiState, Dead);
 }
+
+GAME_TEST(Mm6, SpellParticleTextures) {
+    if (engine->gameVersion() != GAME_VERSION_MM6)
+        GTEST_SKIP() << "MM6 game data required, run with --game-version mm6.";
+
+    // Spell trails, like a goblin's fire bolt, drew the error image for every particle.
+    ASSERT_FALSE(pBitmaps_LOD->exists("effpar01"));
+    SpellFxRenderer *fx = EngineIocContainer::ResolveSpellFxRenderer();
+    for (GraphicsImage *texture : {fx->effpar01, fx->effpar02, fx->effpar03}) {
+        ASSERT_NE(texture, nullptr);
+        EXPECT_EQ(texture->size(), Sizei(64, 64));
+        EXPECT_EQ(texture->rgba()[0][0], Color(0, 0, 0)); // Black corners blend away.
+    }
+    EXPECT_GT(fx->effpar03->rgba()[32][32].r, 200); // Bright in the middle.
+}
